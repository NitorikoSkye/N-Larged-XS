/* The Windows executable's icon (Crash's HUD head, bank47_icons/f034)
 * and version information (platform.mk, HOST_WINDOWS, passes the
 * version from host_platform.h). */
#include <winver.h>

1 ICON "crashbandicootxs.ico"

1 VERSIONINFO
FILEVERSION HOST_VERSION_NUM,0,0
PRODUCTVERSION HOST_VERSION_NUM,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Crash Bandicoot XS"
      VALUE "ProductName", "Crash Bandicoot XS"
      VALUE "FileVersion", HOST_VERSION_STR
      VALUE "ProductVersion", HOST_VERSION_STR
      VALUE "OriginalFilename", HOST_EXE_NAME
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
