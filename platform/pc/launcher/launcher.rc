/* NLargedXSLauncher's icon (its own: an "XS" on the borders' plate, no
 * ROM art) and version information (build.sh passes the version). */
#include <winver.h>

1 ICON "launcher.ico"

1 VERSIONINFO
FILEVERSION LAUNCHER_VERSION_NUM,0,0
PRODUCTVERSION LAUNCHER_VERSION_NUM,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "N. Larged XS Launcher"
      VALUE "ProductName", "N. Larged XS"
      VALUE "FileVersion", LAUNCHER_VERSION_STR
      VALUE "ProductVersion", LAUNCHER_VERSION_STR
      VALUE "OriginalFilename", "NLargedXSLauncher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
